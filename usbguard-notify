#!/usr/bin/env bash

#
# usbguard-notify
#
# Desktop-Agent für USBGuard unter Linux Mint / Cinnamon.
#
# Ein Dialog wird nur angezeigt, wenn ein NEU ANGESCHLOSSENES Gerät
# nach Anwendung der USBGuard-Policy tatsächlich BLOCKIERT bleibt.
#

set -u


# ----------------------------------------------------------------------
# Programme suchen
# ----------------------------------------------------------------------

USBGUARD="$(command -v usbguard || true)"
ZENITY="$(command -v zenity || true)"
FLOCK="$(command -v flock || true)"

if [[ -z "$USBGUARD" ]]; then
    echo "Fehler: usbguard wurde nicht gefunden." >&2
    exit 1
fi

if [[ -z "$ZENITY" ]]; then
    echo "Fehler: zenity wurde nicht gefunden." >&2
    exit 1
fi

if [[ -z "$FLOCK" ]]; then
    echo "Fehler: flock wurde nicht gefunden." >&2
    exit 1
fi


# ----------------------------------------------------------------------
# Nur eine Instanz zulassen
# ----------------------------------------------------------------------

LOCKDIR="${XDG_RUNTIME_DIR:-/tmp}"
LOCKFILE="${LOCKDIR}/usbguard-notify-${UID}.lock"

exec 9>"$LOCKFILE"

if ! "$FLOCK" -n 9; then
    exit 0
fi


# ----------------------------------------------------------------------
# Merken, welche Geräte gerade neu eingesteckt wurden
# ----------------------------------------------------------------------

declare -A INSERT_PENDING


# ----------------------------------------------------------------------
# USB-Interface-Klassen übersetzen
# ----------------------------------------------------------------------

interface_name()
{
    case "$1" in

        03:01:01)
            echo "HID-Tastatur"
            ;;

        03:01:02)
            echo "HID-Maus"
            ;;

        03:00:00)
            echo "HID-Gerät"
            ;;

        08:06:50)
            echo "Massenspeicher"
            ;;

        09:*)
            echo "USB-Hub"
            ;;

        01:*)
            echo "Audio"
            ;;

        02:*|0a:*)
            echo "Netzwerk / Kommunikation"
            ;;

        0e:*)
            echo "Video / Kamera"
            ;;

        e0:*)
            echo "Drahtlose Kommunikation"
            ;;

        ff:*)
            echo "Herstellerspezifisch"
            ;;

        *)
            echo "Unbekannte Schnittstelle"
            ;;

    esac
}


# ----------------------------------------------------------------------
# Dialog anzeigen
# ----------------------------------------------------------------------

show_device()
{
    local device_id="$1"
    local rule="$2"

    local name=""
    local vidpid=""
    local serial=""
    local port=""
    local interfaces=""

    local iface=""
    local iface_name=""
    local interface_text=""
    local warning=""
    local response=""


    # Gerätedaten aus der USBGuard-Regel extrahieren

    name="$(
        sed -n 's/.* name "\([^"]*\)".*/\1/p' <<< "$rule"
    )"

    vidpid="$(
        sed -n 's/.* id \([^ ]*\).*/\1/p' <<< "$rule"
    )"

    serial="$(
        sed -n 's/.* serial "\([^"]*\)".*/\1/p' <<< "$rule"
    )"

    port="$(
        sed -n 's/.* via-port "\([^"]*\)".*/\1/p' <<< "$rule"
    )"

    interfaces="$(
        sed -n \
            's/.* with-interface \(.*\) with-connect-type.*/\1/p' \
            <<< "$rule" |
        tr -d '{}'
    )"


    [[ -z "$name" ]] && name="Unbekannt"
    [[ -z "$vidpid" ]] && vidpid="Unbekannt"
    [[ -z "$serial" ]] && serial="Keine"
    [[ -z "$port" ]] && port="Unbekannt"


    # Interfaces auswerten

    for iface in $interfaces; do

        iface_name="$(interface_name "$iface")"

        interface_text+="${iface_name} (${iface})"$'\n'

        if [[ "$iface" == 03:* ]]; then
            warning=$'\n⚠ WARNUNG: HID-Schnittstelle erkannt!\n'
            warning+=$'Dieses Gerät kann Tastatur- oder Mauseingaben erzeugen.\n'
        fi

    done


    if [[ -z "$interface_text" ]]; then
        interface_text="Unbekannt"
    else
        interface_text="${interface_text%$'\n'}"
    fi


    # ------------------------------------------------------------------
    # Dialog
    #
    # Enter             -> Blockieren
    # ESC / Fenster X   -> Blockiert lassen
    # ------------------------------------------------------------------

    response="$(
        "$ZENITY" \
            --info \
            --title="USBGuard – neues USB-Gerät" \
            --width=520 \
            --text="Ein neues USB-Gerät wurde BLOCKIERT.

Name: $name
USB-ID: $vidpid
Seriennummer: $serial
Port: $port

Schnittstellen:
$interface_text
$warning
Wie soll mit diesem Gerät verfahren werden?" \
            --ok-label="Blockieren" \
            --extra-button="Einmal erlauben" \
            --extra-button="Dauerhaft erlauben" \
            2>/dev/null
    )" || true


    # Benutzerentscheidung

    case "$response" in

        "Einmal erlauben")

            "$USBGUARD" allow-device "$device_id"
            ;;


        "Dauerhaft erlauben")

            if ! "$USBGUARD" allow-device -p "$device_id"; then

                "$ZENITY" \
                    --error \
                    --title="USBGuard – Fehler" \
                    --width=420 \
                    --text="Das Gerät konnte nicht dauerhaft erlaubt werden." \
                    2>/dev/null || true

            fi
            ;;


        *)

            # Gerät bleibt blockiert.
            :
            ;;

    esac
}


# ----------------------------------------------------------------------
# USBGuard überwachen
# ----------------------------------------------------------------------

while IFS= read -r line; do

    # ------------------------------------------------------------------
    # Ein Gerät wurde physisch eingesteckt.
    #
    # Noch KEIN Dialog!
    #
    # Wir merken uns lediglich die Geräte-ID und warten anschließend
    # auf PolicyApplied.
    # ------------------------------------------------------------------

    if [[ "$line" =~ ^\[device\]\ PresenceChanged:\ id=([0-9]+) ]]; then

        device_id="${BASH_REMATCH[1]}"

        IFS= read -r event_line  || continue
        IFS= read -r target_line || continue
        IFS= read -r rule_line   || continue

        if [[ "$event_line" == *"event=Insert"* ]]; then

            INSERT_PENDING["$device_id"]=1

        elif [[ "$event_line" == *"event=Remove"* ]]; then

            unset 'INSERT_PENDING[$device_id]' 2>/dev/null || true

        fi

        continue
    fi


    # ------------------------------------------------------------------
    # USBGuard hat die endgültige Policy auf das Gerät angewendet.
    #
    # Beispiel:
    #
    # [device] PolicyApplied: id=55
    #  target_new=allow
    #  device_rule=allow ...
    #  rule_id=123
    #
    # Erst HIER entscheiden wir, ob ein Dialog notwendig ist.
    # ------------------------------------------------------------------

    if [[ "$line" =~ ^\[device\]\ PolicyApplied:\ id=([0-9]+) ]]; then

        device_id="${BASH_REMATCH[1]}"

        IFS= read -r target_line || continue
        IFS= read -r rule_line   || continue
        IFS= read -r rule_id_line || continue


        # Nur interessant, wenn dieses Gerät gerade neu eingesteckt wurde.

        if [[ -z "${INSERT_PENDING[$device_id]+x}" ]]; then
            continue
        fi


        # Event wurde verarbeitet.
        unset 'INSERT_PENDING[$device_id]'


        # Bekannte Geräte landen hier normalerweise bei:
        #
        # target_new=allow
        #
        # -> kein Dialog.

        if [[ "$target_line" != *"target_new=block"* ]]; then
            continue
        fi


        # Nur wirklich blockierte Geräte melden.

        rule="${rule_line#*device_rule=}"

        show_device "$device_id" "$rule" &

    fi

done < <("$USBGUARD" watch)
